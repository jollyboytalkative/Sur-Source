    "DiscoverySettings": {
      "title": "DiscoverySettings",
      "description": "Private admin configuration for scheduled Search-grounded discovery.",
      "type": "object",
      "properties": {
        "settingId": {
          "type": "string",
          "description": "Configuration document identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether periodic background discovery scans are enabled."
        },
        "intervalHours": {
          "type": "integer",
          "description": "Interval in hours between scheduled background checks."
        },
        "targetDirector": {
          "type": "string",
          "description": "Director filter for automated checks.",
          "enum": [
            "all",
            "nadeem-shravan",
            "anu-malik",
            "rd-burman",
            "shankar-jaikishan",
            "ar-rahman",
            "naushad",
            "op-nayyar",
            "anand-milind",
            "laxmikant-pyarelal",
            "sd-burman",
            "ravi",
            "roshan",
            "madan-mohan"
          ],
          "maxLength": 64
        },
        "batchSize": {
          "type": "integer",
          "description": "Number of Original songs checked per scheduled run."
        },
        "lastScanAtIso": {
          "type": "string",
          "description": "ISO timestamp of the most recent completed scan.",
          "maxLength": 64
        },
        "lastScanSummary": {
          "type": "string",
          "description": "Short summary of the latest discovery scan.",
          "maxLength": 400
