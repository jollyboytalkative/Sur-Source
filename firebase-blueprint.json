{
  "entities": {
    "SongOverride": {
      "title": "SongOverride",
      "description": "Admin-approved live classification and source metadata override for an archive song.",
      "type": "object",
      "properties": {
        "songId": {
          "type": "string",
          "description": "Unique identifier of the song in the archive.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "movieId": {
          "type": "string",
          "description": "Unique identifier of the parent movie.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "directorId": {
          "type": "string",
          "description": "Music director identifier.",
          "enum": [
            "nadeem-shravan",
            "anu-malik",
            "rd-burman",
            "shankar-jaikishan",
            "ar-rahman",
            "naushad",
            "op-nayyar",
            "anand-milind",
            "laxmikant-pyarelal",
            "sd-burman",
            "ravi",
            "roshan",
            "madan-mohan"
          ],
          "maxLength": 64
        },
        "adaptationType": {
          "type": "string",
          "description": "Approved live classification.",
          "enum": [
            "copied",
            "inspired"
          ],
          "maxLength": 32
        },
        "originalSongTitle": {
          "type": "string",
          "description": "Title of the reported original source composition.",
          "minLength": 1,
          "maxLength": 200
        },
        "originalArtist": {
          "type": "string",
          "description": "Performer or composer of the reported original source.",
          "minLength": 1,
          "maxLength": 200
        },
        "originalYear": {
          "type": "string",
          "description": "Release year or era of the original source.",
          "maxLength": 32
        },
        "originCategory": {
          "type": "string",
          "description": "Regional or stylistic origin category.",
          "enum": [
            "Pakistani Film & Ghazal",
            "Nusrat Fateh Ali Khan",
            "Arabic & Middle Eastern",
            "Western Pop & Ambient",
            "African & World Folk",
            "Indian Folk & Classical",
            "Original Composition"
          ],
          "maxLength": 64
        },
        "adaptationNotes": {
          "type": "string",
          "description": "Editorial notes comparing the melody, groove, or arrangement.",
          "maxLength": 1200
        },
        "originalLink": {
          "type": "string",
          "description": "External listening link for the reported original track.",
          "maxLength": 500
        },
        "referenceSource": {
          "type": "string",
          "description": "Source publication, database, or archive reference.",
          "maxLength": 300
        },
        "sourceUrl": {
          "type": "string",
          "description": "Grounded reference article URL.",
          "maxLength": 500
        },
        "discoveryId": {
          "type": "string",
          "description": "Reference ID of the staged discovery queue item.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "approvedBy": {
          "type": "string",
          "description": "Firebase UID of the admin who approved the override.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when override was published."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when override was last updated."
        }
      },
      "required": [
        "songId",
        "movieId",
        "directorId",
        "adaptationType",
        "originalSongTitle",
        "originalArtist",
        "originalYear",
        "originCategory",
        "adaptationNotes",
        "originalLink",
        "referenceSource",
        "sourceUrl",
        "discoveryId",
        "approvedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "DiscoveryCandidate": {
