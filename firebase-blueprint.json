  "firestore": {
    "/song_overrides/{songId}": {
      "schema": {
        "$ref": "#/entities/SongOverride"
      },
      "description": "Publicly readable approved song overrides that dynamically update catalog classifications without redeployment."
    },
    "/discovery_queue/{discoveryId}": {
      "schema": {
        "$ref": "#/entities/DiscoveryCandidate"
      },
      "description": "Private admin review queue holding Search-grounded adaptation discoveries pending 1-click approval."
    },
    "/live_movies/{movieId}": {
      "schema": {
        "$ref": "#/entities/LiveMovie"
      },
      "description": "Publicly readable approved new Hindi film and tracklist additions published dynamically without redeployment."
    },
    "/release_queue/{releaseId}": {
      "schema": {
        "$ref": "#/entities/ReleaseDiscoveryCandidate"
      },
      "description": "Private admin review queue holding Search-grounded newly released or upcoming Hindi films/songs pending 1-click approval."
    },
    "/discovery_settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/DiscoverySettings"
      },
      "description": "Private admin scheduler settings for periodic background discovery scans."
    }
  }
}
