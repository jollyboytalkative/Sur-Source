          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "directorId": {
          "type": "string",
          "description": "Music director identifier.",
          "enum": [
            "nadeem-shravan",
            "anu-malik",
            "rd-burman",
