            "nadeem-shravan",
            "anu-malik",
            "rd-burman",
            "shankar-jaikishan",
            "ar-rahman",
            "naushad",
            "op-nayyar",
            "anand-milind",
            "laxmikant-pyarelal",
            "sd-burman",
            "ravi",
            "roshan",
            "madan-mohan"
          ],
          "maxLength": 64
        },
        "directorName": {
          "type": "string",
          "description": "Display name of the music director.",
          "minLength": 1,
          "maxLength": 120
        },
        "movieTitle": {
          "type": "string",
          "description": "Movie title.",
          "minLength": 1,
          "maxLength": 200
        },
        "movieYear": {
          "type": "integer",
          "description": "Release year of the movie."
        },
        "songTitle": {
          "type": "string",
          "description": "Bollywood song title currently marked Original.",
          "minLength": 1,
          "maxLength": 200
        },
        "singers": {
          "type": "string",
          "description": "Playback singers.",
          "maxLength": 300
        },
        "bollywoodLink": {
          "type": "string",
          "description": "External listening link for the Bollywood song.",
          "maxLength": 500
        },
        "suggestedType": {
          "type": "string",
          "description": "Suggested classification from Search grounding.",
          "enum": [
            "copied",
            "inspired"
          ],
          "maxLength": 32
        },
        "originalSongTitle": {
          "type": "string",
          "description": "Discovered original song title.",
          "minLength": 1,
          "maxLength": 200
        },
        "originalArtist": {
          "type": "string",
          "description": "Discovered original performer or composer.",
          "minLength": 1,
          "maxLength": 200
        },
        "originalYear": {
          "type": "string",
          "description": "Year or era of the discovered original track.",
          "maxLength": 32
        },
        "originCategory": {
          "type": "string",
          "description": "Suggested origin region or style.",
          "enum": [
            "Pakistani Film & Ghazal",
            "Nusrat Fateh Ali Khan",
            "Arabic & Middle Eastern",
            "Western Pop & Ambient",
            "African & World Folk",
            "Indian Folk & Classical",
            "Original Composition"
          ],
          "maxLength": 64
        },
        "adaptationNotes": {
          "type": "string",
          "description": "Grounded summary of the reported similarity.",
          "maxLength": 1200
        },
        "originalLink": {
          "type": "string",
          "description": "External listening link for the discovered original.",
          "maxLength": 500
        },
        "referenceSource": {
          "type": "string",
          "description": "Source attribution label (e.g. ITWOFS, CopycatList, Wikipedia).",
          "maxLength": 300
        },
        "sourceUrl": {
          "type": "string",
          "description": "Primary grounded web source URL.",
          "maxLength": 500
        },
        "sourceTitle": {
          "type": "string",
          "description": "Primary grounded web source title.",
          "maxLength": 300
        },
        "confidence": {
          "type": "string",
          "description": "Evidence confidence tier.",
          "enum": [
            "high",
            "medium"
          ],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "description": "Review queue workflow state.",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "maxLength": 16
        },
        "discoveredAtIso": {
          "type": "string",
          "description": "ISO timestamp when discovery ran.",
          "maxLength": 64
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase UID of the private admin owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "discoveryId",
        "songId",
        "movieId",
        "directorId",
        "directorName",
        "movieTitle",
        "movieYear",
        "songTitle",
        "singers",
        "bollywoodLink",
        "suggestedType",
        "originalSongTitle",
        "originalArtist",
        "originalYear",
        "originCategory",
        "adaptationNotes",
        "originalLink",
        "referenceSource",
        "sourceUrl",
        "sourceTitle",
        "confidence",
        "status",
        "discoveredAtIso",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
